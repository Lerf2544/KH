    wrap.querySelector("#btnAddTeam").addEventListener("click", openAddTeamModal);
    wrap.querySelector("#btnAddPlayer").addEventListener("click", ()=>openAddPlayerModal(null));
    
    // Balance Teams Listener
    const btnBalance = wrap.querySelector("#btnBalance");
    if(btnBalance) btnBalance.addEventListener("click", () => {
      pushHistory();
      
      // Sort free agents by highest level first
      const freeAgents = state.players.filter(p => !p.teamId).sort((a, b) => b.level - a.level);
      
      freeAgents.forEach(player => {
        let lowestTeam = null;
        let lowestStars = Infinity;
        
        // Find team with lowest total stars
        state.teams.forEach(team => {
          const teamPlayers = state.players.filter(p => p.teamId === team.id);
          const totalStars = teamPlayers.reduce((sum, p) => sum + (p.level || 1), 0);
          
          if (totalStars < lowestStars) {
            lowestStars = totalStars;
