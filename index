<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Matchday — Pitch Manager</title>
<style>
  :root{
    --turf-dark:#0F2A20;
    --turf:#173F30;
    --turf-light:#1F5240;
    --card:#1B4A3A;
    --line: rgba(245,243,236,0.16);
    --chalk:#F5F3EC;
    --chalk-dim: rgba(245,243,236,0.62);
    --floodlight:#F2B84B;
    --floodlight-dim: rgba(242,184,75,0.18);
    --danger:#E2574C;
    --danger-dim: rgba(226,87,76,0.18);
    --ok:#4CA771;
    --radius: 14px;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
  html,body{height:100%;}
  body{
    margin:0;
    background:
      repeating-linear-gradient(0deg, var(--turf-dark) 0 64px, var(--turf) 64px 128px);
    color:var(--chalk);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    overflow-x:hidden;
  }
  .num, .timer-digits, .score-num{
    font-variant-numeric: tabular-nums;
    font-stretch: condensed;
  }
  h1,h2,h3{ margin:0; letter-spacing:0.02em; }
  .heading{
    font-weight:800;
    letter-spacing:0.04em;
    text-transform:uppercase;
  }

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky; top:0; z-index:20;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 16px 12px;
    background:linear-gradient(180deg, rgba(15,42,32,0.98), rgba(15,42,32,0.9));
    backdrop-filter: blur(6px);
    border-bottom:1px solid var(--line);
  }
  .brand{
    display:flex; align-items:center; gap:8px;
    font-weight:800; font-size:19px; letter-spacing:0.03em;
  }
  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--floodlight); box-shadow:0 0 8px var(--floodlight);}
  .brand small{display:block; font-weight:500; font-size:10px; color:var(--chalk-dim); letter-spacing:0.14em;}

  /* ---------- Main / tabs ---------- */
  main{ flex:1; padding:14px 14px calc(96px + var(--safe-bottom)); max-width:520px; width:100%; margin:0 auto; }
  .tab-panel{ display:none; animation: fadein .18s ease; }
  .tab-panel.active{ display:block; }
  @keyframes fadein{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

  .bottombar{
    position:fixed; bottom:0; left:0; right:0; z-index:30;
    display:flex; justify-content:center;
    background:linear-gradient(0deg, rgba(9,26,19,0.98), rgba(9,26,19,0.9));
    border-top:1px solid var(--line);
    padding: 8px 10px calc(8px + var(--safe-bottom));
  }
  .bottombar .row{ display:flex; gap:6px; width:100%; max-width:520px; }
  .navbtn{
    flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;
    background:none; border:none; color:var(--chalk-dim);
    font-size:11px; font-weight:700; letter-spacing:0.03em;
    padding:8px 4px; border-radius:12px;
    transition: color .15s, background .15s;
  }
  .navbtn .ic{font-size:19px; line-height:1;}
  .navbtn.active{ color:var(--floodlight); background:rgba(242,184,75,0.1); }

  /* ---------- Generic building blocks ---------- */
  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:16px;
    margin-bottom:14px;
  }
  .section-title{
    font-size:12px; color:var(--chalk-dim); font-weight:800;
    text-transform:uppercase; letter-spacing:0.12em;
    margin: 22px 0 10px; display:flex; align-items:center; gap:8px;
  }
  .section-title:first-child{ margin-top:0; }
  .section-title::after{ content:""; flex:1; height:1px; background:var(--line); }

  .btn{
    appearance:none; border:none; cursor:pointer;
    font-weight:800; letter-spacing:0.02em;
    border-radius:11px; padding:12px 16px; font-size:14px;
    color:var(--turf-dark); background:var(--floodlight);
    transition: transform .08s ease, filter .12s;
  }
  .btn:active{ transform:scale(0.96); filter:brightness(0.95); }
  .btn.secondary{ background:rgba(245,243,236,0.1); color:var(--chalk); border:1px solid var(--line); }
  .btn.danger{ background:var(--danger); color:#fff; }
  .btn.ghost{ background:none; color:var(--chalk-dim); border:1px dashed var(--line); }
  .btn.block{ width:100%; }
  .btn.sm{ padding:8px 12px; font-size:12.5px; border-radius:9px; }
  .btn:disabled{ opacity:0.4; }

  .field{ margin-bottom:12px; }
  .field label{ display:block; font-size:11.5px; color:var(--chalk-dim); font-weight:700; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:6px; }
  .field input[type=text], .field input[type=number], .field select{
    width:100%; background:var(--turf); border:1px solid var(--line); color:var(--chalk);
    padding:11px 12px; border-radius:10px; font-size:15px; font-family:inherit;
  }
  .field input:focus, .field select:focus{ outline:2px solid var(--floodlight); outline-offset:1px; }
  .row-flex{ display:flex; gap:10px; }
  .row-flex > *{ flex:1; min-width:0; }

  .star-picker{ display:flex; gap:8px; }
  .star-opt{
    flex:1; text-align:center; padding:10px 6px; border-radius:10px;
    border:1px solid var(--line); background:var(--turf); cursor:pointer; font-size:13px;
  }
  .star-opt small{ display:block; font-size:10px; color:var(--chalk-dim); margin-top:3px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em;}
  .star-opt.selected{ border-color:var(--floodlight); background:var(--floodlight-dim); }

  .color-picker{ display:flex; flex-wrap:wrap; gap:8px; }
  .swatch{ width:32px; height:32px; border-radius:50%; border:2px solid transparent; cursor:pointer; }
  .swatch.selected{ border-color:var(--chalk); box-shadow:0 0 0 2px var(--turf-dark); }
  .swatch.custom-wrap{ position:relative; width:32px; height:32px; }
  .swatch.custom-wrap input[type=color]{ position:absolute; inset:0; opacity:0; cursor:pointer; }
  .swatch.custom-wrap .cw{ width:100%; height:100%; border-radius:50%; border:2px dashed var(--chalk-dim); display:flex; align-items:center; justify-content:center; font-size:14px; color:var(--chalk-dim); background:var(--turf); }
  .swatch.used{ opacity:0.25; cursor:not-allowed; position:relative; }
  .color-name-label{ text-align:center; font-size:12px; color:var(--chalk-dim); font-weight:700; margin-top:8px; }

  .empty{ text-align:center; padding:26px 12px; color:var(--chalk-dim); font-size:13.5px; }
  .empty .big{ font-size:30px; display:block; margin-bottom:6px; }

  .toast{
    position:fixed; left:50%; bottom:calc(92px + var(--safe-bottom)); transform:translateX(-50%) translateY(8px);
    background:var(--chalk); color:var(--turf-dark); font-weight:700; font-size:13px;
    padding:10px 18px; border-radius:100px; opacity:0; pointer-events:none; transition:opacity .2s, transform .2s;
    z-index:50; white-space:nowrap;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  /* ---------- LIVE tab ---------- */
  .match-picker-row{ display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; margin-bottom:14px; }
  .match-chip{
    flex:0 0 auto; padding:9px 14px; border-radius:100px; font-size:13px; font-weight:700;
    background:var(--turf-light); border:1px solid var(--line); color:var(--chalk-dim); white-space:nowrap;
  }
  .match-chip.active{ background:var(--floodlight); color:var(--turf-dark); border-color:var(--floodlight); }
  .match-chip .st{ font-size:9px; margin-left:5px; opacity:0.75;}

  .scoreboard{
    border-radius:var(--radius); overflow:hidden; border:1px solid var(--line); margin-bottom:14px;
    background:var(--turf-dark);
  }
  .sb-label{ text-align:center; padding:8px; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--chalk-dim); font-weight:800; border-bottom:1px solid var(--line);}
  .sb-halves{ display:flex; position:relative; }
  .sb-halves::after{
    content:""; position:absolute; left:50%; top:10%; bottom:10%; width:0;
    border-left:2px dashed rgba(245,243,236,0.28); transform:translateX(-1px);
  }
  .sb-half{ flex:1; padding:18px 10px 20px; text-align:center; }
  .sb-team-name{ font-weight:800; font-size:13.5px; text-transform:uppercase; letter-spacing:0.03em; margin-bottom:6px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .sb-score{ font-size:52px; font-weight:800; line-height:1; margin:4px 0 14px; }
  .sb-btns{ display:flex; gap:8px; justify-content:center; }
  .sb-btns button{
    width:38px; height:38px; border-radius:50%; border:1px solid var(--line);
    background:rgba(245,243,236,0.08); color:var(--chalk); font-size:18px; font-weight:800; cursor:pointer;
  }
  .sb-btns button:active{ transform:scale(0.9); }

  .timer-card{ text-align:center; }
  .timer-digits{ font-size:56px; font-weight:800; letter-spacing:0.02em; color:var(--floodlight); margin:6px 0 14px; }
  .timer-digits.warn{ color:var(--danger); }
  .timer-controls{ display:flex; gap:10px; justify-content:center; margin-bottom:14px; }
  .timer-controls .btn{ min-width:96px; }

  /* ---------- ROSTER tab ---------- */
  .team-card{ border-radius:var(--radius); border:1px solid var(--line); margin-bottom:14px; overflow:hidden; background:var(--card); }
  .team-card .team-head{ display:flex; align-items:center; gap:10px; padding:12px 14px; border-left:6px solid var(--team-color, var(--floodlight)); background:color-mix(in srgb, var(--team-color, var(--floodlight)) 16%, var(--card)); }
  .team-head .swatch-dot{ width:14px; height:14px; border-radius:50%; background:var(--team-color); flex:0 0 auto; }
  .team-head .tname{ font-weight:800; font-size:15px; flex:1; }
  .team-head .tcount{ font-size:11.5px; color:var(--chalk-dim); font-weight:700; }
  .team-body{ padding:10px 12px 12px; display:flex; flex-wrap:wrap; gap:8px; }

  .player-chip{
    display:flex; align-items:center; gap:7px; background:var(--turf); border:1px solid var(--line);
    border-radius:100px; padding:6px 12px 6px 8px; font-size:13px; cursor:grab;
    touch-action:none; user-select:none; -webkit-user-select:none;
    transition: opacity .12s, outline .12s;
  }
  .player-chip.dragging{ opacity:0.3; }
  .player-chip.drop-target{ outline: 2px dashed var(--floodlight); background: rgba(242,184,75,0.2); }
  .player-chip .jn{
    width:22px; height:22px; border-radius:50%; background:rgba(245,243,236,0.12); color:var(--chalk);
    display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800; flex:0 0 auto;
  }
  .player-chip .stars{ font-size:10px; opacity:0.85; }
  .player-chip .pname{ font-weight:600; }

  .chip-ghost{
    position:fixed; z-index:100; pointer-events:none; opacity:0.96;
    box-shadow:0 8px 20px rgba(0,0,0,0.4); transform:translate(-50%,-50%) scale(1.06);
  }

  .team-body, .pool-body{ transition: background .12s, outline-color .12s; border-radius:10px; min-height:36px; }
  .team-body.drop-hover, .pool-body.drop-hover{ outline:2px dashed var(--floodlight); outline-offset:-2px; background:rgba(242,184,75,0.1); }

  .pool-box{ border:1.5px dashed var(--line); border-radius:var(--radius); padding:14px; margin-bottom:14px; }
  .pool-head{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }
  .pool-head .ic{ font-size:16px; }
  .pool-head .t{ font-weight:800; font-size:13px; text-transform:uppercase; letter-spacing:0.06em; color:var(--chalk-dim); }
  .pool-body{ display:flex; flex-wrap:wrap; gap:8px; }

  /* ---------- Modal (edit player / assign) ---------- */
  .modal-backdrop{
    position:fixed; inset:0; background:rgba(6,18,13,0.7); z-index:60;
    display:flex; align-items:flex-end; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .18s;
  }
  .modal-backdrop.show{ opacity:1; pointer-events:auto; }
  .modal-sheet{
    background:var(--turf); width:100%; max-width:520px; border-radius:18px 18px 0 0;
    padding:18px 18px calc(20px + var(--safe-bottom)); border-top:1px solid var(--line);
    transform:translateY(12px); transition:transform .18s;
    max-height:82vh; overflow-y:auto;
  }
  .modal-backdrop.show .modal-sheet{ transform:none; }
  .modal-title{ font-weight:800; font-size:16px; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; }
  .modal-title .x{ font-size:20px; color:var(--chalk-dim); cursor:pointer; padding:4px; }

  /* ---------- History ---------- */
  .history-item{ border-radius:var(--radius); border:1px solid var(--line); background:var(--card); padding:14px; margin-bottom:12px; }
  .history-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
  .history-top .glabel{ font-size:11px; color:var(--chalk-dim); font-weight:800; text-transform:uppercase; letter-spacing:0.1em; }
  .history-top .gdate{ font-size:11px; color:var(--chalk-dim); }
  .history-score{ display:flex; align-items:center; justify-content:center; gap:14px; }
  .history-score .tname{ flex:1; text-align:center; font-weight:800; font-size:13.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .history-score .num{ font-size:26px; font-weight:800; }
  .history-actions{ display:flex; justify-content:flex-end; margin-top:8px; }

  ::-webkit-scrollbar{ display:none; }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand"><span class="dot"></span><div>MATCHDAY<br><small id="miniStatus">SETTING UP</small></div></div>
  <button class="btn sm secondary" id="btnShare">Share ⤴</button>
</div>

<main>
  <section class="tab-panel active" id="tab-live"></section>
  <section class="tab-panel" id="tab-roster"></section>
  <section class="tab-panel" id="tab-history"></section>
</main>

<div class="bottombar">
  <div class="row">
    <button class="navbtn active" data-tab="live"><span class="ic">⏱</span>Live</button>
    <button class="navbtn" data-tab="roster"><span class="ic">👥</span>Roster</button>
    <button class="navbtn" data-tab="history"><span class="ic">📜</span>History</button>
  </div>
</div>

<div class="toast" id="toast"></div>
<div class="modal-backdrop" id="modalBackdrop"><div class="modal-sheet" id="modalSheet"></div></div>

<script>
(function(){
  "use strict";

  const TEAM_COLORS = [
    {hex:"#E2574C", name:"Red"}, {hex:"#3B82C4", name:"Blue"},
    {hex:"#F2B84B", name:"Yellow"}, {hex:"#4CA771", name:"Green"},
    {hex:"#8B5FBF", name:"Purple"}, {hex:"#E08A3C", name:"Orange"},
    {hex:"#2FA6A0", name:"Teal"}, {hex:"#D6608F", name:"Pink"}
  ];
  const PRESET_COLORS = TEAM_COLORS.map(c=>c.hex);
  const LEVELS = { 1:{label:"Casual", stars:"⭐"}, 2:{label:"Intermediate", stars:"⭐⭐"}, 3:{label:"Pro", stars:"⭐⭐⭐"} };

  function nearestColorName(hex){
    const known = TEAM_COLORS.find(c=>c.hex.toLowerCase()===hex.toLowerCase());
    if(known) return known.name;
    const r = parseInt(hex.slice(1,3),16)/255, g = parseInt(hex.slice(3,5),16)/255, b = parseInt(hex.slice(5,7),16)/255;
    const max = Math.max(r,g,b), min = Math.min(r,g,b), l = (max+min)/2;
    if(max===min) return "Gray";
    let h = 0;
    if(max===r) h = ((g-b)/(max-min) + (g<b?6:0)) * 60;
    else if(max===g) h = ((b-r)/(max-min) + 2) * 60;
    else h = ((r-g)/(max-min) + 4) * 60;
    if(h<15||h>=345) return "Red";
    if(h<45) return "Orange";
    if(h<70) return "Yellow";
    if(h<170) return "Green";
    if(h<200) return "Teal";
    if(h<255) return "Blue";
    if(h<290) return "Purple";
    return "Pink";
  }
  const STORAGE_KEY = "matchday-state-v1";

  let state = {
    teams: [],
    players: [],
    matches: [],
    currentMatchId: null,
    nextGameNum: 1
  };

  // ---------------- Undo / Redo Setup ----------------
  let undoStack = [];
  let redoStack = [];

  function pushHistory() {
    undoStack.push(JSON.stringify(state));
    redoStack = []; 
  }

  function handleUndo() {
    if (undoStack.length === 0) return;
    redoStack.push(JSON.stringify(state));
    state = JSON.parse(undoStack.pop());
    persist(); renderAll();
    showToast("Action undone");
  }

  function handleRedo() {
    if (redoStack.length === 0) return;
    undoStack.push(JSON.stringify(state));
    state = JSON.parse(redoStack.pop());
    persist(); renderAll();
    showToast("Action redone");
  }

  let activeTab = "live";
  let dirty = false;

  // ---------------- Persistence (Browser Safe) ----------------
  async function loadState(){
    try{
      const savedData = localStorage.getItem(STORAGE_KEY);
      if(savedData){
        const parsed = JSON.parse(savedData);
        state = Object.assign(state, parsed);
      }
    }catch(e){ console.error("Load failed", e); }
    renderAll();
  }
  async function saveState(){
    try{ 
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); 
    } catch(e){ console.error("Save failed", e); }
  }
  function persist(){ dirty = true; clearTimeout(persist._t); persist._t = setTimeout(()=>{ if(dirty){ saveState(); dirty=false; } }, 250); }

  // ---------------- Helpers ----------------
  function uid(){ return Math.random().toString(36).slice(2,10); }
  function showToast(msg){
    const t = document.getElementById("toast");
    t.textContent = msg; t.classList.add("show");
    clearTimeout(showToast._t);
    showToast._t = setTimeout(()=>t.classList.remove("show"), 1800);
  }
  function fmtTime(sec){
    sec = Math.max(0, Math.round(sec));
    const m = Math.floor(sec/60), s = sec%60;
    return String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
  }
  function teamById(id){ return state.teams.find(t=>t.id===id); }
  
  // Sort players by jersey number
  function playersOfTeam(id){ 
    return state.players
      .filter(p=>p.teamId===id)
      .sort((a,b) => (a.number||999) - (b.number||999)); 
  }
  
  function currentMatch(){ return state.matches.find(m=>m.id===state.currentMatchId) || null; }
  
  // Find lowest gap number starting from 1
  function getGapNumber(teamId){
    const used = playersOfTeam(teamId).map(p=>p.number).filter(n=>n!=null).sort((a,b)=>a-b);
    let n=1; 
    for(let i=0; i<used.length; i++) {
        if(used[i] === n) n++;
        else if (used[i] > n) break;
    }
    return n;
  }
  
  function vibrate(pattern){ if(navigator.vibrate) navigator.vibrate(pattern); }
  function beep(){
    try{
      const ctx = new (window.AudioContext||window.webkitAudioContext)();
      [0,0.28,0.56].forEach(t=>{
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.type="sine"; o.frequency.value=880;
        g.gain.setValueAtTime(0.0001, ctx.currentTime+t);
        g.gain.exponentialRampToValueAtTime(0.3, ctx.currentTime+t+0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime+t+0.24);
        o.connect(g); g.connect(ctx.destination);
        o.start(ctx.currentTime+t); o.stop(ctx.currentTime+t+0.26);
      });
    }catch(e){}
  }

  // ---------------- Timer loop ----------------
  function tick(){
    const m = currentMatch();
    if(!m || !m.running) return;
    if(m.remainingSec > 0){
      m.remainingSec -= 1;
      if(m.remainingSec === 0){
        m.running = false;
        beep(); vibrate([300,120,300,120,300]);
        showToast("⏱ Time's up!");
        saveState();
      }
      renderLiveTimerOnly();
    }
  }
  setInterval(tick, 1000);
  setInterval(()=>{ const m=currentMatch(); if(m && m.running) saveState(); }, 15000);

  // ================= RENDER: shell =================
  function renderAll(){
    updateMiniStatus();
    renderLive();
    renderRoster();
    renderHistory();
  }
  function updateMiniStatus(){
    const m = currentMatch();
    const el = document.getElementById("miniStatus");
    if(!m){ el.textContent = "SETTING UP"; return; }
    if(m.status==="finished"){ el.textContent = m.label + " · FULL TIME"; return; }
    el.textContent = m.label + (m.running ? " · LIVE" : " · PAUSED");
  }

  function switchTab(tab){
    activeTab = tab;
    document.querySelectorAll(".tab-panel").forEach(p=>p.classList.remove("active"));
    document.getElementById("tab-"+tab).classList.add("active");
    document.querySelectorAll(".navbtn").forEach(b=>b.classList.toggle("active", b.dataset.tab===tab));
  }
  document.querySelectorAll(".navbtn").forEach(b=>b.addEventListener("click", ()=>switchTab(b.dataset.tab)));

  // ================= MODAL helper =================
  function openModal(html){
    document.getElementById("modalSheet").innerHTML = html;
    document.getElementById("modalBackdrop").classList.add("show");
  }
  function closeModal(){ document.getElementById("modalBackdrop").classList.remove("show"); }
  document.getElementById("modalBackdrop").addEventListener("click", (e)=>{ if(e.target.id==="modalBackdrop") closeModal(); });

  // ================= LIVE TAB =================
  function renderLive(){
    const wrap = document.getElementById("tab-live");
    const m = currentMatch();
    let html = "";
    if(state.matches.length){
      html += `<div class="match-picker-row">`;
      state.matches.forEach(mm=>{
        const st = mm.status==="finished" ? "FT" : (mm.running ? "LIVE" : "SET");
        html += `<button class="match-chip ${mm.id===state.currentMatchId?"active":""}" data-pick-match="${mm.id}">${escapeHtml(mm.label)}<span class="st">${st}</span></button>`;
      });
      html += `<button class="match-chip" data-new-match="1">+ New</button>`;
      html += `</div>`;
    }

