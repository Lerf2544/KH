        <select id="mPTeam">
          <option value="not_arrived" ${p.teamId==='not_arrived' ? 'selected' : ''}>Not come yet</option>
          <option value="" ${!p.teamId ? 'selected' : ''}>Unassigned (free agent)</option>
          ${state.teams.map(t=>`<option value="${t.id}" ${t.id===p.teamId?'selected':''}>${escapeHtml(t.name)}</option>`).join("")}
        </select>
      </div>
      <div class="field"><label>Jersey number</label><input type="number" min="1" max="99" id="mPNumber" value="${p.number!=null?p.number:''}"></div>
      <div class="row-flex">
        <button class="btn danger" id="mDelPlayer">Remove</button>
        <button class="btn" id="mSavePlayer">Save changes</button>
      </div>
    `);
    const sheet = document.getElementById("modalSheet");
    sheet.querySelector("[data-close]").addEventListener("click", closeModal);
    sheet.querySelectorAll("[data-level]").forEach(op=>op.addEventListener("click", ()=>{
      sheet.querySelectorAll(".star-opt").forEach(o=>o.classList.remove("selected"));
      op.classList.add("selected"); chosenLevel = Number(op.dataset.level);
    }));
    sheet.querySelector("#mDelPlayer").addEventListener("click", ()=>{
      pushHistory();
      state.players = state.players.filter(x=>x.id!==playerId);
      persist(); closeModal(); renderAll();
      showToast("Player removed");
    });
    sheet.querySelector("#mSavePlayer").addEventListener("click", ()=>{
      const name = sheet.querySelector("#mPName").value.trim();
      if(!name){ showToast("Give the player a name"); return; }
      pushHistory();
      p.name = name; p.level = chosenLevel;
      const prevTeamId = p.teamId;
      p.teamId = sheet.querySelector("#mPTeam").value || null;
      
      const numVal = sheet.querySelector("#mPNumber").value;
      if (p.teamId && p.teamId !== prevTeamId && numVal === "" && p.teamId !== 'not_arrived') {
        p.number = getGapNumber(p.teamId);
      } else {
        p.number = numVal!=="" ? Number(numVal) : null;
      }
      
      persist(); closeModal(); renderAll();
      showToast("Saved ✅");
    });
  }

  // ================= HISTORY TAB =================
  function renderHistory(){
    const wrap = document.getElementById("tab-history");
    const finished = state.matches.filter(m=>m.status==="finished").sort((a,b)=>b.finishedAt-a.finishedAt);
    let html = `<div class="section-title" style="margin-top:0;">Previous matches</div>`;
    if(!finished.length){
      html += `<div class="card empty"><span class="big">📋</span>No finished matches yet.<br>Recorded scores will show up here.</div>`;
    } else {
      finished.forEach(m=>{
        const ta = teamById(m.teamAId), tb = teamById(m.teamBId);
        const d = new Date(m.finishedAt);
        html += `<div class="history-item">
          <div class="history-top"><span class="glabel">${escapeHtml(m.label)}</span><span class="gdate">${d.toLocaleDateString()} ${d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</span></div>
          <div class="history-score">
            <div class="tname" style="color:${ta?ta.color:'#fff'}">${escapeHtml(ta?ta.name:'Team A')}</div>
            <div class="num">${m.scoreA}</div><div style="opacity:.5">–</div><div class="num">${m.scoreB}</div>
            <div class="tname" style="color:${tb?tb.color:'#fff'}">${escapeHtml(tb?tb.name:'Team B')}</div>
          </div>
          <div class="history-actions"><button class="btn sm ghost" data-del-match="${m.id}">Delete</button></div>
        </div>`;
      });
    }
    wrap.innerHTML = html;
    wrap.querySelectorAll("[data-del-match]").forEach(b=>b.addEventListener("click", ()=>{
      if(!confirm("Delete this match record?")) return;
      pushHistory();
      state.matches = state.matches.filter(m=>m.id!==b.dataset.delMatch);
      if(state.currentMatchId===b.dataset.delMatch) state.currentMatchId=null;
      persist(); renderAll();
    }));
  }

  // ---------------- Share ----------------
  document.getElementById("btnShare").addEventListener("click", ()=>{
    const finished = state.matches.filter(m=>m.status==="finished").sort((a,b)=>a.finishedAt-b.finishedAt);
    const live = currentMatch();
    let lines = ["🏟️ MATCHDAY RESULTS"];
    if(live && live.status!=="finished"){
      const ta=teamById(live.teamAId), tb=teamById(live.teamBId);
      lines.push(`\nLive: ${live.label} — ${ta?ta.name:'?'} ${live.scoreA} – ${live.scoreB} ${tb?tb.name:'?'}`);
    }
    if(finished.length){
      lines.push("");
      finished.forEach(m=>{
        const ta=teamById(m.teamAId), tb=teamById(m.teamBId);
        lines.push(`${m.label}: ${ta?ta.name:'?'} ${m.scoreA} – ${m.scoreB} ${tb?tb.name:'?'}`);
      });
    }
    if(!finished.length && !live){ showToast("Nothing to share yet"); return; }
    const text = lines.join("\n");
    if(navigator.share){
      navigator.share({ text }).catch(()=>{});
    } else if(navigator.clipboard){
      navigator.clipboard.writeText(text).then(()=>showToast("Copied results to clipboard 📋"));
    } else {
      showToast("Sharing not supported on this browser");
    }
  });

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, c=>({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
  }

  loadState();
})();
</script>
</body>
</html>
