  // ---------------- Drag & drop ----------------
  let dragState = null;
  const DRAG_THRESHOLD = 8;

  function attachChipDrag(chip){
    chip.addEventListener("pointerdown", (e)=>{
      if(e.pointerType === "mouse" && e.button !== 0) return;
      dragState = {
        playerId: chip.dataset.playerId,
        pointerId: e.pointerId,
        startX: e.clientX, startY: e.clientY,
        moved: false,
        chip, ghost: null
      };
      try{ chip.setPointerCapture(e.pointerId); }catch(err){}
    });
    chip.addEventListener("pointermove", (e)=>{
      if(!dragState || dragState.pointerId !== e.pointerId) return;
      const dx = e.clientX - dragState.startX, dy = e.clientY - dragState.startY;
      if(!dragState.moved && Math.hypot(dx,dy) > DRAG_THRESHOLD){
        dragState.moved = true;
        beginGhost(dragState.chip, e.clientX, e.clientY);
      }
      if(dragState.moved){
        moveGhost(e.clientX, e.clientY);
        updateDropHighlight(e.clientX, e.clientY);
      }
    });
    chip.addEventListener("pointerup", (e)=>{
      if(!dragState || dragState.pointerId !== e.pointerId) return;
      if(dragState.moved){
        completeDrop(e.clientX, e.clientY, dragState.playerId);
      } else {
        openEditPlayerModal(dragState.playerId);
      }
      endDrag();
    });
    chip.addEventListener("pointercancel", ()=>{ endDrag(); });
  }

  function beginGhost(chip, x, y){
    chip.classList.add("dragging");
    const rect = chip.getBoundingClientRect();
    const ghost = chip.cloneNode(true);
    ghost.classList.remove("dragging");
    ghost.classList.add("chip-ghost");
    ghost.style.width = rect.width + "px";
    ghost.style.left = x + "px";
    ghost.style.top = y + "px";
    document.body.appendChild(ghost);
    dragState.ghost = ghost;
  }
  function moveGhost(x,y){
    if(dragState && dragState.ghost){
      dragState.ghost.style.left = x + "px";
      dragState.ghost.style.top = y + "px";
    }
  }
  
  function updateDropHighlight(x,y){
    document.querySelectorAll(".drop-hover").forEach(el=>el.classList.remove("drop-hover"));
    document.querySelectorAll(".drop-target").forEach(el=>el.classList.remove("drop-target"));
    
    const el = document.elementFromPoint(x,y);
    if(!el) return;
    
    const targetChip = el.closest(".player-chip");
    if(targetChip && targetChip.dataset.playerId !== dragState.playerId) {
      targetChip.classList.add("drop-target");
      return;
    }
    
    const zone = el.closest("[data-dropzone]");
    if(zone){
      const container = zone.classList.contains("team-body") || zone.classList.contains("pool-body") ? zone : zone.closest(".team-body, .pool-body");
      if(container) container.classList.add("drop-hover");
    }
  }

  function completeDrop(x,y, playerId){
    document.querySelectorAll(".drop-hover, .drop-target").forEach(el=>{
      el.classList.remove("drop-hover"); el.classList.remove("drop-target");
    });
    
    const p = state.players.find(pl=>pl.id===playerId);
    if(!p) return;
    
    const targetEl = document.elementFromPoint(x,y);
    if(!targetEl) return;

    const targetChip = targetEl.closest(".player-chip");
    const zone = targetEl.closest("[data-dropzone]");

    // Scenario 1: Swapping positions
    if (targetChip && targetChip.dataset.playerId !== playerId) {
      const targetPlayer = state.players.find(pl=>pl.id===targetChip.dataset.playerId);
      
      // Prevent swapping to bypass the Free Agents rule
      if ((p.teamId === 'not_arrived' && targetPlayer.teamId !== null && targetPlayer.teamId !== 'not_arrived') || 
          (targetPlayer.teamId === 'not_arrived' && p.teamId !== null && p.teamId !== 'not_arrived')) {
        showToast("Must move to Free Agents first! 🛑");
        return;
      }
      
      pushHistory();
      const tempTeamId = p.teamId; const tempNumber = p.number;
      p.teamId = targetPlayer.teamId; p.number = targetPlayer.number;
      targetPlayer.teamId = tempTeamId; targetPlayer.number = tempNumber;
      
      persist(); renderAll();
      showToast(`Swapped with ${targetPlayer.name}`);
      return;
    }

    // Scenario 2: Dropped into a team/pool area
    if(zone){
      const newTeamId = zone.dataset.teamId || null;
      if(p.teamId === newTeamId) return; // No change
      
      // Enforce Free Agent staging area
      if (p.teamId === 'not_arrived' && newTeamId !== null && newTeamId !== 'not_arrived') {
          showToast("Drag to Free Agents first! 🛑");
          return;
      }
      
      pushHistory();
      p.teamId = newTeamId;
      if(newTeamId && newTeamId !== 'not_arrived'){
        p.number = getGapNumber(newTeamId);
      } else {
        p.number = null; // Clears jersey number if returning to pool
      }
      
      persist(); renderAll();
      const teamName = newTeamId === 'not_arrived' ? "Not come yet" : (newTeamId ? (teamById(newTeamId)||{}).name : "Free agents");
      showToast(`Moved to ${teamName}`);
    }
  }

  function endDrag(){
    if(dragState){
      if(dragState.chip) dragState.chip.classList.remove("dragging");
      if(dragState.ghost) dragState.ghost.remove();
    }
    document.querySelectorAll(".drop-hover, .drop-target").forEach(el=>{
      el.classList.remove("drop-hover"); el.classList.remove("drop-target");
    });
    dragState = null;
  }

  function playerChip(p){
    const lvl = LEVELS[p.level] || LEVELS[1];
    return `<div class="player-chip" data-player-id="${p.id}">
      ${p.number!=null ? `<span class="jn">${p.number}</span>` : ""}
      <span class="pname">${escapeHtml(p.name)}</span>
