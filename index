      </div>
      <div class="pool-body" data-dropzone="pool" data-team-id="">
        ${unassigned.length ? unassigned.map(p=>playerChip(p)).join("") : `<span style="color:var(--chalk-dim); font-size:12.5px;" data-dropzone="pool" data-team-id="">Drag free agents here.</span>`}
